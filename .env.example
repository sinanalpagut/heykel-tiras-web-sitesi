# Veri adaptörü: "yerel" (varsayılan) veya "firebase"
VITE_DATA_ADAPTER=yerel

# Yerel adaptörde yükleniyor durumlarını görünür kılan yapay gecikme (ms).
# Üretimde 0 bırakın.
VITE_SAHTE_GECIKME=180

# --- Firebase (yalnızca VITE_DATA_ADAPTER=firebase iken gerekir) ---
# Firebase Console > Proje ayarları > Web uygulaması bölümünden alın.
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun; .env sürüm kontrolüne girmez.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Yerel emülatörlere bağlan (firebase emulators:start)
VITE_FIREBASE_EMULATOR=false
